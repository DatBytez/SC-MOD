		<cloaking power="1" max="3" room="2" start="false" />
		<drones power="1" max="2" room="6" start="false" />
		<engines power="2" max="8" room="3" start="true" />
		<medbay power="1" max="1" room="7" start="false" />
		<oxygen power="1" max="3" room="5" start="true" />
		<pilot power="1" max="3" room="1" start="true" />
		<lily_system_bracers power="1" max="3" room="4" start="true" />
		<weapons power="2" max="8" room="0" start="true" />
	</systemList>
	<weaponSlots>3</weaponSlots>
