<FTL>
	<text name="tooltip_sc_strafe_ready">Temporarily increase accuracy and projectile speed by half your evade.</text>
	<text name="tooltip_sc_strafe_manned">Piloting must be manned to activate.</text>

	<text name="stat_bio_weapon">Bio-Weapon: Hull and system damage are negated unless the target ship is organic.</text>
	<text name="stat_rust_weapon">Rust-Weapon: Hull and system damage are negated unless the target ship is automated.</text>
	<text name="stat_fire_fill">Lights all tiles on fire in any room hit</text>
	<text name="stat_breach_fill">Creates a breach on all tiles in any room hit</text>

		<!-- SC CHAINSTEP WEAPONS -->
	<text name="stat_sc_chainstep_header">CHAINSTEP:</text>
	<text name="stat_sc_chainstep_threshold">Minimum fire time: \1 sec</text>
	<text name="stat_sc_chainstep_interval">Time per step: \1 sec</text>
	<text name="stat_sc_chainstep_max">Maximum steps: \1</text>
	<text name="stat_sc_chainstep_radius">Targeting radius per step: \1</text>

	<!-- SC HALO WEAPONS -->
	<text name="desc_sc_halo">HALO: Each damaging missile is accompanied by a decoy missile that can distract enemy defenses.</text>
	<text name="stat_sc_halo_header">HALO:</text>
	<text name="stat_sc_halo_decoys">Fires additional non-damaging decoy missiles with increased spread.</text>

	<!-- SC LIVE WEAPON DISPLAY -->
	<text name="render_sc_halo_step_radius">Step \1/\2 | R: \3</text>

	<!-- SC WEAPON TIPS -->
	<text name="tip_sc_chainstep">Tip: Chainstep weapons can fire before reaching full charge. Waiting longer changes the weapon's properties with each additional charge step.</text>
