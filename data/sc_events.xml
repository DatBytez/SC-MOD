</eventList>

<event name="SC_STORE_TERRAN_ENGINEERS" unique="true">
    <text>A small Terran engineering station offers repairs, ammunition, and refitted ship systems.</text>
    <store>STORE_STANDARD</store>
</event>

<event name="SC_STORE_RAIDER_MARKET" unique="true">
    <text>A raider market operates in the shadow of a burned-out platform. The merchandise is questionable, but functional.</text>
    <store>STORE_STANDARD</store>
</event>

<event name="SC_STORE_PROTOSS_ARCHIVE" unique="true">
    <text>A Protoss archive vessel is willing to trade artifacts and ship components, though their crew watches you with open suspicion.</text>
    <store>STORE_STANDARD</store>
</event>

