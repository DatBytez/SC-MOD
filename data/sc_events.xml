////////////////////////////////////////////////////////////////////////////////////////////////////
    ITEM EVENTS
////////////////////////////////////////////////////////////////////////////////////////////////////
-->

<eventList name="ITEMS_SC">
    <event load="SC_SUPPLY_DEPOT"/>
    <event load="SC_REFINERY_TRADE"/>
    <event load="SC_DERELICT_BATTLECRUISER"/>
    <event load="SC_PROTOSS_RELIC_CACHE"/>
</eventList>

<event name="SC_SUPPLY_DEPOT" unique="true">
    <text>You locate a Terran supply depot broadcasting an automated Federation-compatible ID check. The depot dispenses a small package of resources.</text>
    <autoReward level="MED">stuff</autoReward>
    <choice hidden="true">
        <text>Continue...</text>
        <event/>
    </choice>
</event>

<event name="SC_REFINERY_TRADE" unique="true">
    <text>A refinery crew offers to trade fuel cells for drone parts and ammunition.</text>
    <choice>
        <text>Trade for fuel.</text>
        <event>
            <item_modify>
                <item type="fuel" min="4" max="6"/>
                <item type="drones" min="-2" max="-1"/>
            </item_modify>
        </event>
    </choice>
    <choice>
        <text>Decline.</text>
        <event/>
    </choice>
</event>

<event name="SC_DERELICT_BATTLECRUISER" unique="true">
    <text>A shattered battlecruiser drifts nearby. Its weapons are offline, but the wreck is still large enough to hide hazards.</text>
    <choice hidden="true">
        <text>Search the wreck.</text>
        <event load="SC_DERELICT_BATTLECRUISER_SEARCH"/>
    </choice>
    <choice>
        <text>Leave it alone.</text>
        <event/>
    </choice>
</event>

<eventList name="SC_DERELICT_BATTLECRUISER_SEARCH">
    <event>
        <text>You find an intact weapons locker deep inside the wreck.</text>
        <autoReward level="MED">weapon</autoReward>
    </event>
    <event>
        <text>The wreck shifts while your crew is inside. You pull away quickly, but debris scrapes across the hull.</text>
        <damage amount="2"/>
        <autoReward level="LOW">scrap_only</autoReward>
    </event>
    <event>
        <text>An infested vessel was hiding in the wreckage. It powers up and attacks.</text>
        <ship load="SC_SHIP_INFESTED_VESSEL" hostile="true"/>
        <choice hidden="true">
            <text>Continue...</text>
            <event load="COMBAT_CHECK"/>
        </choice>
    </event>
</eventList>

<event name="SC_PROTOSS_RELIC_CACHE" unique="true">
    <text>Your sensors detect a sealed Protoss cache. It may contain valuable technology, or it may be guarded.</text>
    <choice hidden="true">
        <text>Open the cache.</text>
        <event load="SC_PROTOSS_RELIC_CACHE_LIST"/>
    </choice>
    <choice>
        <text>Do not disturb it.</text>
        <event/>
    </choice>
</event>

<eventList name="SC_PROTOSS_RELIC_CACHE_LIST">
    <event>
        <text>The cache contains advanced components that can be converted for your ship.</text>
        <autoReward level="HIGH">augment</autoReward>
    </event>
    <event>
        <text>The cache broadcasts a warning signal. A Protoss strike craft decloaks and attacks.</text>
        <ship load="SC_SHIP_PROTOSS_STRIKE" hostile="true"/>
        <choice hidden="true">
            <text>Continue...</text>
            <event load="COMBAT_CHECK"/>
        </choice>
    </event>
</eventList>

