<eventList name="DISTRESS_SC">
    <event load="SC_DISTRESS_ZERG_RAID"/>
    <event load="SC_DISTRESS_SCIENCE_VESSEL"/>
    <event load="SC_DISTRESS_REFUGEE_CONVOY"/>
    <event load="SC_DISTRESS_PLATFORM_FIRE"/>
</eventList>

<event name="SC_DISTRESS_ZERG_RAID" unique="true">
    <distressBeacon/>
    <text>A colony is broadcasting a distress signal. A swarm vessel is closing in, and the colonists are begging for help.</text>
    <choice hidden="true">
        <text>Defend the colony.</text>
        <event>
            <ship load="SC_SHIP_ZERG_SWARM" hostile="true"/>
            <choice hidden="true">
                <text>Continue...</text>
                <event load="COMBAT_CHECK"/>
            </choice>
        </event>
    </choice>
    <choice>
        <text>Ignore the distress call.</text>
        <event/>
    </choice>
</event>

<event name="SC_DISTRESS_SCIENCE_VESSEL" unique="true">
    <distressBeacon/>
    <text>A damaged science vessel is venting atmosphere. Its crew needs time to restore life support.</text>
    <ship load="SC_SHIP_RESCUE_TARGET" hostile="false"/>
    <choice hidden="true">
        <text>Send aid.</text>
        <event load="SC_DISTRESS_SCIENCE_VESSEL_AID"/>
    </choice>
    <choice hidden="true">
        <text>Attack and loot the vessel.</text>
        <event>
            <ship hostile="true"/>
            <choice hidden="true">
                <text>Continue...</text>
                <event load="COMBAT_CHECK"/>
            </choice>
        </event>
    </choice>
</event>

<eventList name="SC_DISTRESS_SCIENCE_VESSEL_AID">
    <event>
        <text>Your crew stabilizes the vessel. The scientists reward you with experimental parts.</text>
        <autoReward level="HIGH">drone</autoReward>
    </event>
    <event>
        <text>The damage is worse than expected. You save some of the crew, but your own ship takes damage during the rescue.</text>
        <crewMember amount="1" class="human"/>
        <damage amount="2"/>
    </event>
</eventList>

<event name="SC_DISTRESS_REFUGEE_CONVOY" unique="true">
    <distressBeacon/>
    <text>A refugee convoy is being shadowed by raiders. The convoy asks you to escort them to a safer route.</text>
    <choice hidden="true">
        <text>Escort the convoy.</text>
        <event>
            <quest event="SC_QUEST_REFUGEE_CONVOY_ARRIVE"/>
            <autoReward level="LOW">fuel_only</autoReward>
        </event>
    </choice>
    <choice>
        <text>You cannot help.</text>
        <event/>
    </choice>
</event>

<event name="SC_QUEST_REFUGEE_CONVOY_ARRIVE">
    <beaconType id="map_icon_quest" global="true">
        <color r="69" g="168" b="235" a="1"/>
        <unvisitedTooltip>Escort the refugee convoy through hostile SC sector space.</unvisitedTooltip>
    </beaconType>
    <text>The convoy arrives behind you, but raiders tracked their jump signature. They move to attack.</text>
    <ship load="SC_SHIP_TERRAN_RAIDERS" hostile="true"/>
    <choice hidden="true">
        <text>Continue...</text>
        <event load="COMBAT_CHECK"/>
    </choice>
</event>

<event name="SC_DISTRESS_PLATFORM_FIRE" unique="true">
    <distressBeacon/>
    <text>A platform is burning after an industrial accident. Its crew is trapped behind sealed bulkheads.</text>
    <choice hidden="true">
        <text>Send a rescue team.</text>
        <event load="SC_DISTRESS_PLATFORM_FIRE_RESCUE"/>
    </choice>
    <choice hidden="true" req="terran_scv">
        <text>(SCV Crew) Send your SCV to cut through the damaged bulkheads.</text>
        <event>
            <text>Your SCV gets the doors open before the fire spreads. The platform crew rewards you.</text>
            <autoReward level="HIGH">standard</autoReward>
        </event>
    </choice>
    <choice>
        <text>Leave before the platform explodes.</text>
        <event/>
    </choice>
</event>

<eventList name="SC_DISTRESS_PLATFORM_FIRE_RESCUE">
    <event>
        <text>Your crew manages to pull several workers out before the platform collapses.</text>
        <autoReward level="MED">standard</autoReward>
    </event>
    <event>
        <text>The platform shifts while your crew is inside. One crew member barely makes it back alive.</text>
        <removeCrew>
            <clone>true</clone>
            <text>Your Clone Bay recovers the lost crew member.</text>
        </removeCrew>
        <autoReward level="LOW">scrap_only</autoReward>
    </event>
</eventList>

