</eventList>

<event name="SC_COLONY_CHECKPOINT" unique="true">
    <text>A Terran checkpoint scans your ship and demands identification. They are not hostile yet, but their guns track your movement.</text>
    <ship load="SC_SHIP_TERRAN_PATROL" hostile="false"/>
    <choice hidden="true">
        <text>Submit to the inspection.</text>
        <event load="SC_COLONY_CHECKPOINT_INSPECTION"/>
    </choice>
    <choice hidden="true">
        <text>Attack first.</text>
        <event>
            <ship hostile="true"/>
            <choice hidden="true">
                <text>Continue...</text>
                <event load="COMBAT_CHECK"/>
            </choice>
        </event>
    </choice>
    <choice>
        <text>Leave before this escalates.</text>
        <event/>
    </choice>
</event>

<eventList name="SC_COLONY_CHECKPOINT_INSPECTION">
    <event>
        <text>Your credentials pass. The patrol sends over a modest clearance stipend.</text>
        <autoReward level="LOW">stuff</autoReward>
    </event>
    <event>
        <text>The patrol captain decides your ship is too dangerous to let pass.</text>
        <ship hostile="true"/>
        <choice hidden="true">
            <text>Continue...</text>
            <event load="COMBAT_CHECK"/>
        </choice>
    </event>
</eventList>

<event name="SC_MINING_OUTPOST" unique="true">
    <text>A mining outpost reports unstable mineral deposits nearby. They could pay you to help extract them, but the operation is risky.</text>
    <choice hidden="true">
        <text>Help with the extraction.</text>
        <event load="SC_MINING_OUTPOST_RESULTS"/>
    </choice>
    <choice>
        <text>Decline.</text>
        <event/>
    </choice>
</event>

<eventList name="SC_MINING_OUTPOST_RESULTS">
    <event>
        <text>The extraction succeeds. The miners send over a generous cut.</text>
        <autoReward level="HIGH">scrap_only</autoReward>
    </event>
    <event>
        <text>The deposit detonates under your cutting beams. Your hull takes the worst of it.</text>
        <damage amount="3"/>
        <damage amount="1" system="random"/>
    </event>
    <event>
        <text>Raiders were waiting for someone to expose the ore. They move in to claim it by force.</text>
        <ship load="SC_SHIP_TERRAN_RAIDERS" hostile="true"/>
        <choice hidden="true">
            <text>Continue...</text>
            <event load="COMBAT_CHECK"/>
        </choice>
    </event>
</eventList>

<event name="SC_PROTOSS_ENVOY" unique="true">
    <text>A Protoss envoy refuses to explain its mission, but offers a brief exchange of supplies to avoid conflict.</text>
    <ship load="SC_SHIP_PROTOSS_STRIKE" hostile="false"/>
    <choice hidden="true">
        <text>Accept the exchange.</text>
        <event>
            <autoReward level="LOW">standard</autoReward>
            <ship hostile="false"/>
        </event>
    </choice>
    <choice hidden="true">
        <text>Demand answers.</text>
        <event>
            <text>The envoy interprets your demand as a threat.</text>
            <ship hostile="true"/>
            <choice hidden="true">
                <text>Continue...</text>
                <event load="COMBAT_CHECK"/>
            </choice>
        </event>
    </choice>
</event>

<event name="SC_SCV_REPAIR_CALL" unique="true">
    <text>A group of SCVs has been stranded after repairing a nearby platform. They offer to patch your ship if you can spare supplies.</text>
    <choice>
        <text>Pay them for repairs.</text>
        <event>
            <item_modify>
                <item type="scrap" min="-20" max="-15"/>
            </item_modify>
            <damage amount="-8"/>
        </event>
    </choice>
    <choice>
        <text>Decline.</text>
        <event/>
    </choice>
</event>

<event name="SC_INFESTATION_WARNING" unique="true">
    <text>A panicked broadcast warns that an infested ship is drifting through the area. You can investigate or keep your distance.</text>
    <choice hidden="true">
        <text>Investigate the warning.</text>
        <event load="SC_INFESTATION_WARNING_LIST"/>
    </choice>
    <choice>
        <text>Keep your distance.</text>
        <event/>
    </choice>
</event>

<eventList name="SC_INFESTATION_WARNING_LIST">
    <event>
        <text>The warning was old. The area is clear, and you recover abandoned supplies.</text>
        <autoReward level="LOW">standard</autoReward>
    </event>
    <event>
        <text>The infested vessel is very real. It turns toward you immediately.</text>
        <ship load="SC_SHIP_INFESTED_VESSEL" hostile="true"/>
        <choice hidden="true">
            <text>Continue...</text>
            <event load="COMBAT_CHECK"/>
        </choice>
    </event>
</eventList>

