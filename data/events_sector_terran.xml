	<event load="SC_TERRAN_PATROL_EVADE_FAILURE"/>
	<event load="SC_TERRAN_PATROL_EVADE_FAILURE"/>
	<event load="SC_TERRAN_PATROL_EVADE_FAILURE"/>
	<event load="SC_TERRAN_PATROL_EVADE_FAILURE"/>
</eventList>
<eventList name="SC_TERRAN_PATROL_EVADE_ROLL_3">
	<event load="SC_TERRAN_PATROL_EVADE_SUCCESS"/>
	<event load="SC_TERRAN_PATROL_EVADE_SUCCESS"/>
	<event load="SC_TERRAN_PATROL_EVADE_SUCCESS"/>
	<event load="SC_TERRAN_PATROL_EVADE_FAILURE"/>
