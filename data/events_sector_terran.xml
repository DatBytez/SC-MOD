<textList name="SC_TXT_LIST_GHOST">
	<text>Not a problem.</text>
	<text>Consider it done.</text>
	<text>You call the shots.</text>
</textList>

<event name="SC_BOARDER_MARINE">
	<text>Enemy assault team approaching!</text>
	<boarders min="3" max="5" class="terran_marine"/>
	<boarders min="1" max="2" class="terran_medic"/>
	<ship load="PIRATE"/>
</event>

<event name="SC_BOARDER_FIRE">
	<text>Need a light?</text>
	<boarders min="0" max="1" class="terran_medic"/>
	<boarders min="1" max="2" class="terran_firebat"/>
	<ship load="PIRATE"/>
</event>

<event name="SC_BOARDER_GHOST">
	<text>A team of specialists has been sent to collect the bounty on your head.</text>
	<boarders min="1" max="3" class="terran_ghost"/>
	<ship load="PIRATE"/>
</event>

<event name="SC_TEST">
