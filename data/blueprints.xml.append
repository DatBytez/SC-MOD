<droneBlueprint name="TERRAN_MATRIX_1">
	<type>SHIELD</type>
	<level>1</level>
	<tip>tip_defense</tip>
	<title>Terran Defense Matrix Lv1</title>
	<short>Defense Matrix 1</short>
	<desc>The defensive matrix is a deflection field that provides strong defenses up front but recovers slowly.</desc>
	<power>2</power>
	<cooldown>1</cooldown>
	<dodge>1</dodge>
	<speed>30</speed>
	<cost>55</cost>
	<bp>2</bp>
	<droneImage>terran_matrix</droneImage>
	<rarity>2</rarity>
	<iconImage>shield</iconImage>
	<chargeSound>shieldDroneCharge</chargeSound> <!--The sound to play as the drone slows down.-->
	<activateSound>shieldDroneActivate</activateSound> <!--The sound to play as the drone activates.-->
	<slowDuration>0.01</slowDuration> <!--The time it takes for the drone to slow to a stop.-->
	<pulseDuration>0.01</pulseDuration> <!--The time it takes for the drone to activate once it has stopped.-->
	<layers>1</layers> <!--The number of super shield points added per pulse by the drone.-->
	<cooldowns> <!--The amount of time between super shield additions. Varies based on the number of super shield layers active.-->
		<noLayers>0.1</noLayers>
		<oneLayer>0.1</oneLayer>
		<twoLayer>8.0</twoLayer>
		<threeLayer>16.0</threeLayer>
		<moreLayer>32.0</moreLayer>
	</cooldowns>
</droneBlueprint>

