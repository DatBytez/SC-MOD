	<!-- 
*********************************************************************************************************
  TERRAN SYSTEMS
*********************************************************************************************************
-->
<systemBlueprint name="lily_system_bracers">
    <type>doors</type>
    <title>System Bracers</title>
    <desc>Passively protects your systems from damage, redirecting system damage towards itself instead (As long as it isn't destroyed itself).</desc>
    <startPower>1</startPower>
    <maxPower>4</maxPower>
    <rarity>2</rarity>
    <upgradeCost>
        <level>30</level>
        <level>50</level>
        <level>80</level>
        <level>100</level>
    </upgradeCost>
    <cost>30</cost>
</systemBlueprint>

<!-- 
**********************************************************************************************************************
  TERRAN AUGMENTS
**********************************************************************************************************************
-->

<augBlueprint name="TERRAN_WRAITH_BATTERY">
	<title>Apollo Reactor</title>
	<desc>High yield uranium reactors designed by the Terran Confederacy. 
	
	UPGRADE: Battery System +2
	Systems powered by the reactor recover more quickly from ion damage and have increased performance.
			- Cloak: Reduced Downtime.
			- Engines: Increased evasion. [[wip: increased ftl charge.]]
			- Oxygen: Automated fire supression. Increased refill speed.
			- Clone: Increased clone speed. [[wip: Reduced Skill Drain.]]
			- Drone: Drone speed. [[wip: Drone Rebuild Speed.]]
			</desc>
	<cost>120</cost>
	<bp>8</bp>
	<rarity>4</rarity>
	<stackable>false</stackable>
	<sc-upgrade system="battery" amount="2"/>
</augBlueprint>

<augBlueprint name="TERRAN_SHIP_ARMOR_LIGHT">
	<title>Light Armor Plating</title>
	<desc>Light neosteel hulls and reinforced structural bracers provide better maneuverability at a cost of durability. 
	
	REDUCE: System Bracers -1
	System Bracers have a chance to block incoming damage (System Bracer Health * 20%)
	BONUS: Evasion +2% per engine level
	Pilot can perform straif runs (Increase Accuracy and Projectile Speed at the cost of Evasion)
	</desc>
	<cost>120</cost>
	<bp>8</bp>
	<rarity>3</rarity>
	<stackable>false</stackable>
	<sc-upgrade system="lily_system_bracers" amount="-1"/>
	<sc-armor/>
	<sc-dodge amount="+2"/>
</augBlueprint>

<augBlueprint name="TERRAN_SHIP_ARMOR_MEDIUM">
	<title>Medium Armor Plating</title>
	<desc>Layered neosteel hulls and reinforced structural plating make this ship more durable, at a slight cost to maneuverability. 
	
	UPGRADE: System Bracers +1
	System Bracers have a chance to block incoming damage (System Bracer Health * 20%)
	PENALTY: Evasion -1% per engine level
	</desc>
	<cost>140</cost>
	<bp>8</bp>
	<rarity>3</rarity>
	<stackable>false</stackable>
	<sc-upgrade system="lily_system_bracers" amount="1"/>
	<sc-armor/>
	<sc-dodge amount="-1"/>
</augBlueprint>

<augBlueprint name="TERRAN_SHIP_ARMOR_HEAVY">
	<title>Heavy Armor Plating</title>
	<desc>Layered neosteel hulls and reinforced structural plating make this ship more durable, at a significan cost to maneuverability 
	
	UPGRADE: System Bracers +2
	System Bracers have a chance to block incoming damage (System Bracer Health * 20%)
	PENALTY: Evasion -2% per engine level
	</desc>
	<cost>160</cost>
	<bp>8</bp>
	<rarity>4</rarity>
	<stackable>false</stackable>
	<sc-upgrade system="lily_system_bracers" amount="2"/>
	<sc-armor/>
	<sc-dodge amount="-2"/>
</augBlueprint>

