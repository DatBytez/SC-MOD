    	<function name="FTL_BOOSTER" value="0.30" useForReqs="true" warning="false"/>
		<locked/>
    </aug>
	<aug name="TERRAN_HIDDEN_FTL_BOOSTER_4">
    	<function name="FTL_BOOSTER" value="0.40" useForReqs="true" warning="false"/>
