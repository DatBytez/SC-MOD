			</req>
			
			<temporaryEffect>
				<canMove>true</canMove>
				<controllable>false</controllable>
				<duration>2</duration>
				<powerSounds>
					<powerSound>terran_spider_run</powerSound>
				</powerSounds>
			</temporaryEffect>

		</powerEffect>
		
		<powerEffect name="Self-Destruct">
			<hideCooldown>true</hideCooldown>
			<hideButton>true</hideButton> 
			
			<cooldown>1</cooldown>
			<onHotkey>never</onHotkey>
			<activateWhenReady enemiesOnly="false">true</activateWhenReady>
 
			<chargeReq>
				<enemyInRoom/>
				<requiredSystem functional="true">drone</requiredSystem>
			</chargeReq>

			<req type="enemy"> 
				<enemyInRoom/>
				<requiredSystem functional="true">drone</requiredSystem>
			</req>
			<req type="player"> 
				<enemyInRoom/>
				<requiredSystem functional="true">drone</requiredSystem>
			</req>

			<persDamage>5</persDamage>
			<selfHealth>-999.0</selfHealth>
			<powerEffectSounds enemy="true"> <!-- Sound effects to use when the power effect goes off.-->
				<powerSound>terran_spider_death</powerSound>
			</powerEffectSounds>
		</powerEffect>
	</race>
</crew>


