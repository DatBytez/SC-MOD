<?xml version="1.0" encoding="UTF-8"?>

<advancedCrewTooltips enabled="true" ally="false" enemy="false" rounding="2"/>
<eventTooltips enabled="true"/>
<showNumericalWeaponCooldown enabled="true"/>
<redesignedWeaponTooltips enabled="true"/>
<redesignedDroneTooltips enabled="true"/>
<redesignedAugmentTooltips enabled="true"/>
<showReactor enabled="true"/>
<extraShipInfo missileCount="true" droneCount="true" crewLimit="true"/>
<alternateCrewMovement enabled="true"/>
<rightClickDoorOpening enabled="true"/>
<showShipAchievements enabled="true" toggle="true" hideIfMissing="true" id="hangar_achievements_title_default"/>
<droneSelectHotkeys enabled="true"/>
<droneSaveStations enabled="true"/>
<showDummyEquipmentSlots enabled="true" opacity="0.3"/>
<cloakRenderFix enabled="true"/>
<enhancedCloneUI enabled="true"/>
<insertNewlineForMultipleCrewTooltips enabled="true"/>
<multipleOverCapacity enabled="true"/>
<oxygenWithoutSystem enabled="true"/>
<playerHpColorFix enabled="true"/>
<preIgniteChargers enabled="true"/>
<showDummyEquipmentSlots enabled="true" opacity="0.2"/>
<showScrapCollectorScrap enabled="true"/>
<rightClickDoorOpening enabled="true"/>

<alternateOxygenRendering enabled="false">
    <gradient>
        <color r="255" g="176" b="169" oxygen="0.0"/>
        <color r="230" g="226" b="219" oxygen="100.0"/>
    </gradient>
</alternateOxygenRendering>

<shieldWithoutSystem enabled="true"/>
<dualMedical enabled="true"/>
<scaleSlugGel enabled="true"/>

<titleScreen logo_x="0" logo_y="533" enabled="true"> <!--when not enabled gives the bad install screen-->
