<!--
*********************************************************************************************************
  TERRAN CIVILIAN
*********************************************************************************************************
-->
<crew>
	<race name="terran_civilian">
		<animBase>human</animBase>
		<maxHealth>80</maxHealth>
		<canFight>false</canFight>
		<canSabotage>false</canSabotage>
		<canShoot>false</canShoot>
		<deathSounds>
			<deathSound>terran_civilian_death</deathSound>
		</deathSounds>
		<repairSounds>
			<repairSound>ability_repair1</repairSound>
			<repairSound>ability_repair2</repairSound>
			<repairSound>ability_repair3</repairSound>
			<repairSound>ability_repair4</repairSound>
			<repairSound>ability_repair5</repairSound>
		</repairSounds>
         	<skills>
         		<piloting req="12"/>
         		<engines req="12"/>
         		<shields req="65"/>
         		<weapons req="60"/>
         		<repair req="14"/>
         		<combat req="20"/>
         	</skills>
		<damageTakenMultiplier>1.4</damageTakenMultiplier>
		<!-- STATIC ABILITIES -->
		<repairSpeed>1.4</repairSpeed>
		<fireRepairMultiplier>1.4</fireRepairMultiplier>
		
		<powerEffect name="Repair">
			<req type="player">
				<extraConditions type="or">
					<repairingBreach>true</repairingBreach>
					<repairingSystem>true</repairingSystem>
				</extraConditions>
			</req>
			<req type="enemy">
				<extraConditions type="and">
					<repairingSystem>true</repairingSystem>
				</extraConditions>
			</req>
			<cooldown>1.5</cooldown>
			<jumpCooldown>full</jumpCooldown>
			<hideCooldown>true</hideCooldown>   
			<hideButton>true</hideButton>
			<onHotkey>never</onHotkey>
			<sortOrder>999</sortOrder>
			<animFrame followCrew="true">-1</animFrame>
			<effectAnim>sc_repair</effectAnim>
			<activateWhenReady enemiesOnly="false">true</activateWhenReady>
		</powerEffect>
		
		<!--
		<powerEffect name="Repair_Breach">
			<req type="player">
				<extraConditions type="and">
					<repairingBreach>true</repairingBreach>
				</extraConditions>
			</req>
			<req type="enemy">
				<extraConditions type="and">
					<repairingBreach>true</repairingBreach>
				</extraConditions>
			</req>
			<cooldown>1.5</cooldown>
			<jumpCooldown>full</jumpCooldown>
			<hideCooldown>true</hideCooldown>   
			<hideButton>true</hideButton>
			<onHotkey>never</onHotkey>
			<sortOrder>999</sortOrder>
			<animFrame followCrew="true">-1</animFrame>
			<effectAnim>sc_repair</effectAnim>
			<activateWhenReady enemiesOnly="false">true</activateWhenReady>
		</powerEffect>
		-->
	</race>

	<!-- 
*********************************************************************************************************
  TERRAN MARINE
*********************************************************************************************************
-->
	<race name="terran_marine">
		<animBase>human</animBase>
		<maxHealth>80</maxHealth>
		<rangedDamageMultiplier>1.5</rangedDamageMultiplier>
		<canPunch>false</canPunch>
		<deathSounds>
			<deathSound>terran_marine_death</deathSound>
			<deathSound>terran_marine_death2</deathSound>
		</deathSounds>
		<shootingSounds>
			<shootingSound>terran_marine_attack</shootingSound>
		</shootingSounds>
		<repairSounds>
			<repairSound>ability_repair1</repairSound>
			<repairSound>ability_repair2</repairSound>
			<repairSound>ability_repair3</repairSound>
