	<!-- 
*********************************************************************************************************
  TERRAN AUGMENTS
*********************************************************************************************************
-->

<augments>
    <aug name="TERRAN_SHIP_ARMOR_LIGHT">
        <statBoosts>
            <statBoost name="repairSpeed">
                <boostType>MULT</boostType>
                <shipTarget>ORIGINAL_SHIP</shipTarget>
                <crewTarget>ALLIES</crewTarget>
                <droneTarget>ALL</droneTarget>
                <amount>2</amount>
                <priority>0</priority>
                <systemRoomTarget>ALL</systemRoomTarget>
                <systemList>
                    <lily_system_bracers/>
                </systemList>
            </statBoost>
        </statBoosts>
    </aug>
	
    <aug name="TERRAN_SHIP_ARMOR_MEDIUM">
        <statBoosts>
            <statBoost name="repairSpeed">
                <boostType>MULT</boostType>
                <shipTarget>ORIGINAL_SHIP</shipTarget>
                <crewTarget>ALLIES</crewTarget>
                <droneTarget>ALL</droneTarget>
                <amount>2</amount>
                <priority>0</priority>
                <systemRoomTarget>ALL</systemRoomTarget>
                <systemList>
                    <lily_system_bracers/>
                </systemList>
            </statBoost>
        </statBoosts>
    </aug>
	
    <aug name="TERRAN_SHIP_ARMOR_HEAVY">
        <statBoosts>
            <statBoost name="repairSpeed">
                <boostType>MULT</boostType>
                <shipTarget>ORIGINAL_SHIP</shipTarget>
                <crewTarget>ALLIES</crewTarget>
                <droneTarget>ALL</droneTarget>
                <amount>2</amount>
                <priority>0</priority>
                <systemRoomTarget>ALL</systemRoomTarget>
                <systemList>
                    <lily_system_bracers/>
                </systemList>
            </statBoost>
        </statBoosts>
    </aug>
	
	<!-- TERRAN_WRAITH_BATTERY HIDDEN AUGS -->
	
	<aug name="TERRAN_HIDDEN_FIRE_EXTINGUISHERS">
		<function name="FIRE_EXTINGUISHERS" value="1" useForReqs="true" warning="false"/>
		<locked/>
	</aug>
	<aug name="TERRAN_HIDDEN_FIRE_EXTINGUISHERS_1">
		<function name="FIRE_EXTINGUISHERS" value="1" useForReqs="true" warning="false"/>
