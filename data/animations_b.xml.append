	<sheet>terran_scv</sheet>
	<desc length="3" x="3" y="7" />
	<time>1.0</time>
</anim>
<anim name="terran_scv_fire_down">
	<sheet>terran_scv</sheet>
	<desc length="4" x="0" y="10" />
	<time>1.0</time>
</anim>
