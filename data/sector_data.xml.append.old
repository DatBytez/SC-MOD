<sectorDescription name="SECTOR_ID" unique="false">
	<nameList>
<name>Cool Sector</name>
<name>Cool Space</name>
<name>Cool Settlements</name>
</nameList>
<trackList>
	<track>song1</track>
<track>song2</track>
</trackList>
<rarityList>
	<blueprint name="human" rarity="5"/>
<blueprint name="shell" rarity="1"/>
</rarityList>
<startEvent>ENTER_COOL</startEvent>

<event name="STORELIST_COOL" min="1" max="2"/>

<event name="ITEMS_COOL" min="3" max="4"/>
<event name="NEUTRAL_COOL" min="4" max="5"/>
<event name="DISTRESS_COOL" min="1" max="2"/>
<event name="QUESTS_COOL" min="1" max="1"/>

<event name="HOSTILE_COOL" min="4" max="6"/>

<event name="PIRACY_LIST" min="0" max="2"/>
<event name="FILLER_LIST" min="5" max="5"/>
</sectorDescription>
</FTL>